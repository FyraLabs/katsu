ARG DERIVE_FROM

# Build a bootc derivation for a Katsu live ISO.
#
# This Containerfile is referenced from the manifest via `bootc.derivation`
# (see katsu-iso-bootc.yaml). Katsu runs it as:
#
#   podman build -t <image>:katsu_deriv --build-arg DERIVE_FROM=<image> \
#     -f bootc/Containerfile <context>
#
# so anything added here lands in the rootfs that gets committed to the ISO's
# OSTree repository.

FROM ${DERIVE_FROM}

# kernel + dracut: needed so the deployment has a kernel and initramfs for
# `ostree admin deploy` to extract into the sysroot.
#
# Note: no fuse-overlayfs. That was only required by the old `nested` layout,
# which embedded the OCI image inside its own containers-storage and therefore
# needed to nest overlayfs. The `ostree` layout exports the rootfs directly.
RUN --mount=type=cache,target=/var/cache \
    dnf install -y kernel dracut dracut-live

# Uncomment to add a test user.
# password 'password' for testuser
# RUN useradd -G wheel testuser && \
#     usermod -p '$y$j9T$Ot5YNY7Q/GMEV6aWRuWUP/$oVWQ7UoTd0f518jhezB.RMhrWreChe4W3H2kES1Zx/6' testuser

# HACK: Make /var/tmp a symlink to /tmp, as bootc expects at runtime.
# This is a bootc implementation detail; consider whether katsu should handle it.
RUN rm -rf /var/tmp && \
    ln -sr /tmp /var/tmp

# convenience: record the source image tag
RUN echo "${DERIVE_FROM}" > /etc/bootc-image