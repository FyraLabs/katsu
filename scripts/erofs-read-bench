#!/usr/bin/env python3
"""Measure cold random-read latency on an EROFS payload.

Used by the `iso-bootc-x86_64-comptest` CI job so a configuration cannot look
good on size alone while making the live system slow. The payload is loop-mounted
by the caller; this samples its content-addressed objects.

Reads go through the filesystem rather than O_DIRECT: EROFS over a loop device
rejects O_DIRECT with EINVAL, so the caller drops the page cache first and that is
what makes the samples cold.

The file set and offsets are derived from a fixed seed, so every variant in a
comparison reads exactly the same bytes.

Note the scope: a composefs payload has no `usr/` at its root, so these objects
reflect the cluster size, fragments mode and compression algorithm, but *not* the
per-path `--compress-hints` entries, whose patterns match paths inside the
composefs image. Hints variants will therefore measure alike here.
"""

import argparse
import os
import random
import sys
import time

BLOCK = 4096
SAMPLES = 300
SEED = 0xC0FFEE


def collect(root: str, block: int) -> list[str]:
    """Every file with at least one aligned block to read from, in a stable order."""
    files: list[str] = []
    for dirpath, dirnames, names in os.walk(root):
        dirnames.sort()
        for name in sorted(names):
            path = os.path.join(dirpath, name)
            try:
                # Strictly greater: a file of exactly `block` bytes is eligible by a
                # `>=` test but has no valid offset range, and `randrange(0, 0)`
                # raises `ValueError: empty range`. One block long is common enough
                # (small configs, symlink targets) to hit on a real payload.
                if os.path.getsize(path) > block:
                    files.append(path)
            except OSError:
                # Unreadable entries are not fatal: the point is a comparable
                # sample, not exhaustiveness.
                pass
    files.sort()
    return files


def measure(files: list[str], block: int, samples: int, seed: int) -> list[float]:
    rng = random.Random(seed)
    latencies = []
    for _ in range(samples):
        path = files[rng.randrange(len(files))]
        # Block-aligned so the read does not straddle a cluster boundary, and capped
        # so the whole block fits.
        offset = offsets_for(os.path.getsize(path), block, rng)
        fd = os.open(path, os.O_RDONLY)
        try:
            start = time.perf_counter()
            os.pread(fd, block, offset)
            latencies.append(time.perf_counter() - start)
        finally:
            os.close(fd)
    latencies.sort()
    return latencies


def percentile(latencies: list[float], fraction: float) -> float:
    index = min(len(latencies) - 1, int(len(latencies) * fraction))
    return latencies[index] * 1e6


def offsets_for(size: int, block: int, rng: random.Random) -> int:
    """A random block-aligned offset whose whole block fits inside `size`.

    `size` must be strictly greater than `block`; `collect` guarantees that. Split
    out because the arithmetic is easy to get subtly wrong: a `>=` filter admits a
    file of exactly `block` bytes, whose only candidate offset is 0 and which then
    reads past EOF by a full block.
    """
    max_offset = (size // block - 1) * block
    return rng.randrange(0, max_offset // block + 1) * block


def self_test() -> int:
    """Check the sampling invariants. Run with --self-test."""
    import tempfile

    block = BLOCK
    rng = random.Random(1)

    # Every candidate offset must leave a whole block inside the file. A `>=`
    # filter once admitted an exactly-one-block file, whose only offset reads a
    # full block past EOF, and `randrange(0, 0)` raised on it in CI.
    for size in range(block + 1, block * 8 + 2):
        for _ in range(20):
            offset = offsets_for(size, block, rng)
            assert offset % block == 0, f"{size}: {offset} not aligned"
            assert offset >= 0, f"{size}: negative offset {offset}"
            assert offset + block <= size, f"{size}: read to {offset + block} past EOF"

    # A file of exactly one block must be excluded by the collector, and a larger
    # one included.
    with tempfile.TemporaryDirectory() as tmp:
        for name, size in (("exact", block), ("small", block - 1), ("big", block * 3)):
            with open(os.path.join(tmp, name), "wb") as fh:
                fh.write(b"x" * size)
        files = collect(tmp, block)
        assert [os.path.basename(p) for p in files] == ["big"], files

    print("self-test ok")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", help="mounted EROFS root to sample")
    parser.add_argument("--samples", type=int, default=SAMPLES)
    parser.add_argument("--block", type=int, default=BLOCK)
    parser.add_argument("--seed", type=lambda v: int(v, 0), default=SEED)
    parser.add_argument("--self-test", action="store_true", help="check sampling invariants")
    args = parser.parse_args()

    if args.self_test:
        return self_test()

    if args.root is None:
        parser.error("a root path is required unless --self-test is given")
    if args.samples < 1:
        parser.error("--samples must be at least 1")

    files = collect(args.root, args.block)
    if not files:
        print(
            f"no files larger than {args.block} bytes under {args.root}; "
            "nothing to sample",
            file=sys.stderr,
        )
        return 1

    latencies = measure(files, args.block, args.samples, args.seed)
    print(
        f"{percentile(latencies, 0.5):.0f}us / "
        f"{percentile(latencies, 0.9):.0f}us / "
        f"{percentile(latencies, 0.99):.0f}us "
        f"({len(files)} files, {len(latencies)} samples)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())